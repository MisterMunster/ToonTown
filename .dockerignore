# ALLOWLIST: ignore everything, then re-include only what the image build
# needs. Anything else that lands in the project folder (.env files, SSH keys,
# node_modules, dist, .git, .claude, logs, tools/preview, ...) never enters the
# Docker build context. If you add a root-level build config file (e.g. a
# postcss.config.js), add a "!" line for it here.
*

!package.json
!package-lock.json
!index.html
!vite.config.js
!public
!src
!server

# Only the build helper from tools/ (not the smoke tests or preview pages).
!tools/precompress.mjs

# Never send these, even if they appear inside an allowed folder.
**/.env
**/.env.*
**/*.pem
**/*.key
**/.DS_Store
**/*.log
**/node_modules
