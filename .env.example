# Toon Town server settings.
#   cp .env.example .env    then edit .env (it is git- and docker-ignored).
# Used by docker compose (env_file) - or export them yourself for `npm start`.

# REQUIRED: the password your friends type on the login page.
# A few random words make a great one, e.g. purple-otter-bakes-pies
# If it contains $, # or quotes, wrap it in SINGLE quotes, e.g.
#   GAME_PASSWORD='otter$pies #2'
# (unquoted, Docker Compose turns otter$pies into "otter", with only a warning).
GAME_PASSWORD=

# RECOMMENDED: secret used to sign login cookies. If empty, a random one is
# made at every start, so everybody has to log in again after a restart or
# redeploy. Generate one with:   openssl rand -hex 32
SESSION_SECRET=

# How many days a login stays valid (default 30).
SESSION_DAYS=30

# Docker only: where compose publishes the app on the host (default 8080 on all
# interfaces). Behind Caddy/Nginx on the same server use 127.0.0.1:8080 so the
# plain-HTTP port isn't reachable from the internet (Docker-published ports
# bypass ufw/firewalld). deploy/deploy.sh refuses to deploy without that.
PUBLISH=8080

# Production with deploy/compose.prod.yml (Caddy + automatic HTTPS) only: the
# domain whose DNS A record points at the server.
# SITE_DOMAIN=game.example.com

# --- Advanced (the defaults are right for almost everyone) -------------------

# Which proxies may set X-Forwarded-For / X-Forwarded-Proto. The default trusts
# local and private-network addresses (Caddy/Nginx on the host, Docker networks):
#   loopback, linklocal, uniquelocal
# "false" trusts nobody; a number trusts that many hops (e.g. 1 behind a CDN).
# TRUST_PROXY=loopback, linklocal, uniquelocal

# Port the server listens on (default 8080). Leave it alone in Docker - change
# PUBLISH instead.
# PORT=8080

# Directory with the built game (default: dist/ next to server/).
# DIST_DIR=/app/dist
